{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true, "skipLibCheck": true,
    "esModuleInterop": true, "resolveJsonModule": true, "noEmit": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "erasableSyntaxOnly": true,
    "types": ["vite/client"],
    "paths": { "@ten98/ui": ["./src/lib/index.ts"], "@ten98/ui/app": ["./src/lib/app.tsx"], "@ten98/ui/*.css": ["./src/lib/*.css"] }
  },
  "include": ["src", "tests/browser", "tests/fixtures"]
}
